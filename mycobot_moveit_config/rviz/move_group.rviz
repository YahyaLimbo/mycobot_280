    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MarkerArray
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /display_contacts
      Value: true
    # NO Image displays here, deliberately. Adding an rviz_default_plugins/Image
    # display to THIS config segfaults RViz on load (exit -11), which takes
    # Gazebo, move_group and the controller spawners down with it through the
    # launch teardown -- so the whole simulation dies and the GL errors in the
    # log send you hunting the wrong thing.
    #
    # Bisected 2026-08-31: an Image display is fine on its own. The dedicated
    # mycobot_calibration/rviz/handeye_calibration.rviz carries one and runs
    # indefinitely. It is the COMBINATION of Image with MoveIt's
    # MotionPlanning display that crashes, and adding "Median window" and
    # "Transport Hint" does not help.
    #
    # To see the detections, use the separate viewport instead:
    #     ros2 launch mycobot_calibration handeye_calibration.launch.py \
    #         run_collector:=false show_detections:=true
    # or  ros2 run rqt_image_view rqt_image_view /aruco_detector/debug_image
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
