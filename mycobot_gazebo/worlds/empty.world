<?xml version="1.0" ?>
<!--
  Empty world for Ignition Gazebo Fortress
  Adapted from automaticaddison/mycobot_ros2 for ROS2 Humble + Ignition Fortress
-->
<sdf version="1.6">
  <world name="default">

    <!-- Physics step size matches controller update rate (100 Hz) to avoid
         sim clock backward-step artefacts on WSL2 that clear the TF buffer -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <!-- Plugin for simulating physics -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>

    <!-- Plugin for handling user commands -->
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <!-- Plugin for broadcasting scene updates -->
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <!-- Plugin for handling sensors like the LIDAR and camera -->
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Plugin for IMU -->
    <plugin 
      filename="ignition-gazebo-imu-system"
      name="ignition::gazebo::systems::Imu">
    </plugin>

    <!-- Gravity -->
    <gravity>0.0 0.0 -9.8</gravity>

    <!-- Include a model of the Sun from Fuel -->
    <include>
      <uri>
        https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Sun
      </uri>
    </include>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <coefficient>0.0</coefficient>
              </torsional>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Fill lights. The Fuel Sun is a single directional light (-0.5 0.1 -0.9), so faces
      turned away from it were lit only by ambient: material_ambient(0.4) *
      scene_ambient(0.4) = 0.16, i.e. 16% brightness. That made the arm's pure-white
      textures read as mid-grey. Raising <ambient> alone cannot fix it -- the links'
      COLLADA material ambient is 0.4, which caps the ambient term at 0.4 no matter how
      high the scene value goes. These two shadowless fills are not capped, and lift the
      unlit faces without washing out the sun-facing ones.
    -->
    <light type="directional" name="fill_opposite">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.45 0.45 0.45 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.5 -0.1 -0.6</direction>
    </light>

    <light type="directional" name="fill_side">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.35 0.35 0.35 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.2 0.9 -0.35</direction>
    </light>

    <!-- Scene properties -->
    <scene>
      <shadows>false</shadows>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

  </world>
</sdf>
