<?xml version="1.0" ?>
<!--
  Calibration world for Ignition Gazebo Fortress
  Contains a table for placing the robot arm during hand-eye calibration.
  Adapted from automaticaddison/mycobot_ros2 for ROS2 Humble + Ignition Fortress
-->
<sdf version="1.6">
  <world name="calibration_world">

    <!-- Physics step size matches controller update rate (100 Hz) -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <!-- Plugin for simulating physics -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>

    <!-- Plugin for handling user commands -->
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <!-- Plugin for broadcasting scene updates -->
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <!-- Plugin for handling sensors like the camera -->
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Plugin for IMU -->
    <plugin 
      filename="ignition-gazebo-imu-system"
      name="ignition::gazebo::systems::Imu">
    </plugin>

    <!-- Gravity -->
    <gravity>0.0 0.0 -9.8</gravity>

    <!-- Include a model of the Sun from Fuel -->
    <include>
      <uri>
        https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Sun
      </uri>
    </include>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Calibration Table -->
    <!-- Full-spec table per supervisor's documentation:
           - 1.0 m x 0.8 m top surface
           - 0.4 m height (top surface center at z=0.4)
           - Four cylindrical legs (radius 0.03 m, length 0.4 m) at the corners
         Implemented as a SINGLE static link with multiple <collision>/<visual>
         children (no internal joints) — this avoids the DART
         RevoluteJoint::verifyTransform crash that occurred with multi-link
         static models in Ignition Fortress + dartsim 6.12. -->
    <model name="calibration_table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="table">

        <!-- Top slab -->
        <collision name="top_collision">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry>
            <box><size>1.0 0.8 0.05</size></box>
          </geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry>
            <box><size>1.0 0.8 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

        <!-- Leg 1: +X +Y corner -->
        <collision name="leg1_collision">
          <pose>0.45 0.35 0.175 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.35</length></cylinder>
          </geometry>
        </collision>
        <visual name="leg1_visual">
          <pose>0.45 0.35 0.175 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.35</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>

        <!-- Leg 2: -X +Y corner -->
        <collision name="leg2_collision">
          <pose>-0.45 0.35 0.175 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.35</length></cylinder>
          </geometry>
        </collision>
        <visual name="leg2_visual">
          <pose>-0.45 0.35 0.175 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.35</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>

        <!-- Leg 3: +X -Y corner -->
        <collision name="leg3_collision">
          <pose>0.45 -0.35 0.175 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.35</length></cylinder>
          </geometry>
        </collision>
        <visual name="leg3_visual">
          <pose>0.45 -0.35 0.175 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.35</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>

        <!-- Leg 4: -X -Y corner -->
        <collision name="leg4_collision">
          <pose>-0.45 -0.35 0.175 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.35</length></cylinder>
          </geometry>
        </collision>
        <visual name="leg4_visual">
          <pose>-0.45 -0.35 0.175 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.35</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!--
      Fill lights -- kept identical to empty.world so the arm looks the same in both.
      The Fuel Sun is a single directional light (-0.5 0.1 -0.9), so faces turned away
      from it were lit only by ambient: the arm links' COLLADA material ambient is 0.4,
      so at scene_ambient 0.5 those faces sat at 0.4 * 0.5 = 0.20 -- which made their
      pure-white textures read as mid-grey. Raising <ambient> alone cannot fix it: the
      material's 0.4 caps the ambient term at 0.4 however high the scene value goes.
      These two shadowless fills are not capped. Specular is 0 so they add no new
      highlights to the table or legs.
    -->
    <light type="directional" name="fill_opposite">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.45 0.45 0.45 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.5 -0.1 -0.6</direction>
    </light>

    <light type="directional" name="fill_side">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.35 0.35 0.35 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.2 0.9 -0.35</direction>
    </light>

    <!-- Scene properties -->
    <scene>
      <shadows>false</shadows>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

  </world>
</sdf>
